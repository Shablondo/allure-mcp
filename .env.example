# URL вашего сервера Allure TestOps
ALLURE_TESTOPS_URL=https://your-allure-testops.com

# API токен для аутентификации (получить в профиле Allure TestOps)
ALLURE_TESTOPS_API_TOKEN=your-api-token-here

# ID проекта по умолчанию (может быть переопределен при вызове инструментов)
ALLURE_TESTOPS_PROJECT_ID=123

# Таймаут запросов в секундах (по умолчанию: 30)
ALLURE_TESTOPS_TIMEOUT=30

# Кэширование - TTL в секундах (по умолчанию: 300 = 5 минут)
# Установите 0 чтобы отключить кэширование
ALLURE_TESTOPS_CACHE_TTL=300

# Retry настройки
ALLURE_TESTOPS_RETRY_ATTEMPTS=3
ALLURE_TESTOPS_NETWORK_RETRY_ATTEMPTS=1
ALLURE_TESTOPS_RETRY_DELAY=2

# Circuit Breaker настройки
ALLURE_TESTOPS_CIRCUIT_BREAKER_FAILURES=5
ALLURE_TESTOPS_CIRCUIT_BREAKER_TIMEOUT=60

# HTTP пул настройки
ALLURE_TESTOPS_MAX_CONNECTIONS=100
ALLURE_TESTOPS_MAX_KEEPALIVE_CONNECTIONS=20
